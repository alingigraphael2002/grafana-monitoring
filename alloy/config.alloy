logging {
  level  = "info"
  format = "logfmt"
}

// Built-in Alloy metrics -> Mimir
prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "15s"
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}

// Example: scrape Loki and Mimir HTTP metrics too
prometheus.scrape "stack" {
  targets = [
    {"__address__" = "loki:3100", "job" = "loki"},
    {"__address__" = "mimir:9009", "job" = "mimir"},
  ]
  forward_to      = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "15s"
}

// NestJS API metrics -> Mimir
prometheus.scrape "nestjs_demo" {
  targets = [
    {
      "__address__" = "nestjs-observability-demo:3000",
      "job"         = "nestjs-observability-demo",
    },
  ]
  metrics_path    = "/metrics"
  forward_to      = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "15s"
}

// Discover the demo API container and attach useful Loki stream labels.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "nestjs_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/nestjs-observability-demo"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    target_label = "service_name"
    replacement  = "nestjs-observability-demo"
  }
}

loki.source.docker "nestjs_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.nestjs_logs.output
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// OTLP traces from applications -> Tempo
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
