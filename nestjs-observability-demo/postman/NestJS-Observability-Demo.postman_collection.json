{
  "info": {
    "_postman_id": "7d59804e-8689-42c0-8562-73c04e9c2a1a",
    "name": "NestJS Observability Demo",
    "description": "Separated requests for generating Loki logs and Mimir metrics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "slowDelayMs", "value": "1500" },
    { "key": "retryFailures", "value": "2" },
    { "key": "dependency", "value": "postgresql_citus" },
    { "key": "failAt", "value": "external_api" }
  ],
  "item": [
    {
      "name": "01 - Service and Health",
      "item": [
        {
          "name": "Service information",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/" },
          "response": []
        },
        {
          "name": "Health check",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Service is healthy', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ] }
          }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health" },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Successful Requests",
      "item": [
        {
          "name": "Hello - default",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/hello" },
          "response": []
        },
        {
          "name": "Hello - custom name and request ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-request-id", "value": "postman-hello-{{$guid}}" }],
            "url": "{{baseUrl}}/api/hello?name=Grafana"
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Request and Response Size",
      "item": [
        {
          "name": "Echo - small JSON payload",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello from Postman\",\n  \"source\": \"small-payload-test\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/echo"
          },
          "response": []
        },
        {
          "name": "Echo - larger structured payload",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"{{$guid}}\",\n  \"customer\": {\"name\": \"Grafana Learner\", \"email\": \"learner@example.com\"},\n  \"items\": [\n    {\"sku\": \"DEMO-001\", \"quantity\": 2, \"price\": 19.99},\n    {\"sku\": \"DEMO-002\", \"quantity\": 1, \"price\": 49.99}\n  ],\n  \"metadata\": {\"source\": \"postman\", \"purpose\": \"payload-size testing\"}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/echo"
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Performance and Duration",
      "item": [
        {
          "name": "Slow - configured delay",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/slow?ms={{slowDelayMs}}" },
          "response": []
        },
        {
          "name": "Slow - 5 seconds",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/slow?ms=5000" },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Errors and Timeouts",
      "description": "These responses intentionally have error status codes.",
      "item": [
        {
          "name": "Intentional HTTP 500",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Intentional status is 500', () => pm.response.to.have.status(500));"] }
          }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/error" },
          "response": []
        },
        {
          "name": "Simulated HTTP 504 timeout",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Intentional status is 504', () => pm.response.to.have.status(504));"] }
          }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/timeout" },
          "response": []
        }
      ]
    },
    {
      "name": "06 - Retry Simulation",
      "item": [
        {
          "name": "Retry - configured failures",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/retry?failures={{retryFailures}}" },
          "response": []
        },
        {
          "name": "Retry - maximum 5 failures",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/retry?failures=5" },
          "response": []
        }
      ]
    },
    {
      "name": "07 - Rate Limit Sequence",
      "description": "Run this folder in Collection Runner. Requests 1-5 are accepted; 6-7 should return 429. The limit resets after one minute or an API restart.",
      "item": [
        {
          "name": "01 - Accepted",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/rate-limit" },
          "response": []
        },
        {
          "name": "02 - Accepted",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/rate-limit" },
          "response": []
        },
        {
          "name": "03 - Accepted",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/rate-limit" },
          "response": []
        },
        {
          "name": "04 - Accepted",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/rate-limit" },
          "response": []
        },
        {
          "name": "05 - Accepted",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/rate-limit" },
          "response": []
        },
        {
          "name": "06 - Rejected with HTTP 429",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Rate limit status is 429', () => pm.response.to.have.status(429));"] }
          }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/rate-limit" },
          "response": []
        },
        {
          "name": "07 - Rejected with HTTP 429",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Rate limit status is 429', () => pm.response.to.have.status(429));"] }
          }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/rate-limit" },
          "response": []
        }
      ]
    },
    {
      "name": "08 - Observability",
      "item": [
        {
          "name": "Prometheus metrics",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Metrics status is 200', () => pm.response.to.have.status(200));",
              "pm.test('API metric exists', () => pm.expect(pm.response.text()).to.include('api_requests_total'));",
              "pm.test('Dependency metric exists', () => pm.expect(pm.response.text()).to.include('dependency_requests_total'));",
              "pm.test('Business metric exists', () => pm.expect(pm.response.text()).to.include('business_transactions_total'));"
            ] }
          }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/metrics" },
          "response": []
        }
      ]
    },
    {
      "name": "09 - Distributed Tracing Workflow",
      "description": "Each checkout creates an HTTP server span plus child spans for gateway, authentication, authorisation, application logic, PostgreSQL/Citus, Redis, Kafka publish/consume, an external API, and file storage.",
      "item": [
        {
          "name": "Checkout - complete successful trace",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Checkout succeeds', () => pm.response.to.have.status(201));",
              "pm.test('Trace ID returned', () => pm.expect(pm.response.json().trace_id).to.be.a('string'));"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-request-id", "value": "checkout-success-{{$guid}}" },
              { "key": "x-demo-role", "value": "customer" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"order_id\": \"{{$guid}}\",\n  \"amount\": 149.95,\n  \"items\": 3,\n  \"channel\": \"postman\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/checkout"
          },
          "response": []
        },
        {
          "name": "Checkout - controlled dependency failure",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Dependency failure returns 503', () => pm.response.to.have.status(503));"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-request-id", "value": "checkout-failure-{{$guid}}" },
              { "key": "x-demo-role", "value": "customer" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"order_id\": \"{{$guid}}\",\n  \"amount\": 79.50,\n  \"items\": 2,\n  \"channel\": \"postman\",\n  \"fail_at\": \"{{failAt}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/checkout"
          },
          "response": []
        },
        {
          "name": "Checkout - Kafka consume failure",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Kafka consume failure returns 503', () => pm.response.to.have.status(503));"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-request-id", "value": "checkout-kafka-consume-{{$guid}}" },
              { "key": "x-demo-role", "value": "customer" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"order_id\": \"{{$guid}}\",\n  \"amount\": 55.25,\n  \"items\": 1,\n  \"channel\": \"postman\",\n  \"fail_at\": \"kafka_consume\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/checkout"
          },
          "response": []
        },
        {
          "name": "Checkout - authorization denied",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Authorization failure returns 403', () => pm.response.to.have.status(403));"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-request-id", "value": "checkout-denied-{{$guid}}" },
              { "key": "x-demo-role", "value": "denied" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 25,\n  \"items\": 1,\n  \"channel\": \"postman\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/checkout"
          },
          "response": []
        }
      ]
    },
    {
      "name": "10 - Dependency Metrics",
      "description": "Target individual simulated dependencies. Add ?fail=true to record failure metrics and an error span. For Kafka, use operation=publish_event or operation=consume_event.",
      "item": [
        {
          "name": "Configured dependency",
          "request": { "method": "GET", "header": [{ "key": "x-request-id", "value": "dependency-{{$guid}}" }], "url": "{{baseUrl}}/api/dependencies/{{dependency}}" },
          "response": []
        },
        {
          "name": "PostgreSQL/Citus query",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dependencies/postgresql_citus" },
          "response": []
        },
        {
          "name": "Kafka publish",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dependencies/kafka?operation=publish_event" },
          "response": []
        },
        {
          "name": "Kafka consume",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dependencies/kafka?operation=consume_event" },
          "response": []
        },
        {
          "name": "External API call",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dependencies/external_api" },
          "response": []
        },
        {
          "name": "Redis/cache operation",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dependencies/redis_cache" },
          "response": []
        },
        {
          "name": "File storage operation",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dependencies/file_storage" },
          "response": []
        },
        {
          "name": "Authentication provider",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dependencies/auth_provider" },
          "response": []
        },
        {
          "name": "External API failure",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Dependency failure returns 503', () => pm.response.to.have.status(503));"] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dependencies/external_api?fail=true" },
          "response": []
        }
      ]
    },
    {
      "name": "11 - Business, Error, and SLO Telemetry",
      "description": "Run this folder repeatedly to populate business value, classified errors, availability, success rate, latency, error rate, throughput, and SLO panels.",
      "item": [
        {
          "name": "Business checkout - web channel",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Checkout succeeds', () => pm.response.to.have.status(201));"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "x-demo-role", "value": "customer" }],
            "body": { "mode": "raw", "raw": "{\n  \"order_id\": \"{{$guid}}\",\n  \"amount\": 249.99,\n  \"items\": 4,\n  \"channel\": \"web\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/checkout"
          },
          "response": []
        },
        {
          "name": "Latency SLO breach",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/slow?ms=1200" },
          "response": []
        },
        {
          "name": "Availability and 5xx error",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Intentional status is 500', () => pm.response.to.have.status(500));"] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/error" },
          "response": []
        },
        {
          "name": "Success-rate SLO breach (timeout)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Intentional status is 504', () => pm.response.to.have.status(504));"] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/timeout" },
          "response": []
        },
        {
          "name": "Throughput burst - hello",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/hello?name=slo" },
          "response": []
        }
      ]
    }
  ]
}
